/**
 * Implements hook_install().
 *
 * Creates the user_tracking table used to store basic navigation history.
 */
function rep_install() {
  // Define the schema for the user_tracking table.
  $schema['user_tracking'] = [
    'description' => 'Stores user session history.',
    'fields' => [
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'User ID.',
      ],
      'previous_url' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Previous URL.',
      ],
      'current_url' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Current URL.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Timestamp when the entry was created.',
      ],
    ],
    'primary key' => ['uid', 'current_url'],
  ];

  // Create the table in the active connection.
  Database::getConnection()->schema()->createTable('user_tracking', $schema['user_tracking']);
}

/**
 * Implements hook_form_alter().
 *
 * Used here to remove the default submit button from specific REP forms,
 * because those forms use custom action buttons / redirects.
 */
function rep_form_alter(&$form, &$form_state, $form_id) {
  // Check if the form ID matches one of the REP configuration forms.
  if ($form_id == 'rep_form_namespace' ||
      $form_id == 'rep_form_preferred_names' ||
      $form_id == 'rep_form_update_namespace') {
    // Remove the default "Save configuration" button.
    unset($form['actions']['submit']);
  }
}

/**
 * Implements hook_theme().
 *
 * Registers custom theme hooks for REP.
 */
function rep_theme($existing, $type, $theme, $path) {
  return [
    'list-page' => [
      'variables' => [
        'items' => [
          'offset' => '',
          'first' => '',
          'last' => '',
          'previous' => '',
          'next' => '',
          'links' => [],
          'title' => '',
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 *
 * Attaches required libraries to all blocks rendered by Drupal.
 */
function rep_preprocess_block(&$variables) {
  // Attach the core AJAX dialog library to all blocks.
  $variables['#attached']['library'][] = 'core/drupal.dialog.ajax';

  // Attach the custom REP JS/CSS library to all blocks as well.
  // (This assumes that 'rep/rep_js_css' is defined in rep.libraries.yml.)
  $variables['#attached']['library'][] = 'rep/rep_js_css';
}

/**
 * Implements hook_help().
 *
 * Provides simple help text for the REP module.
 */
function rep_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'rep.help':
      return '<h2>This is the help content for the HAScO Semantics Package.</h2>';
  }
}

/**
 * Implements hook_update_N().
 *
 * Update 8001: Set the front page to a REP listing route.
 */
function rep_update_8001() {
  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('page.front', '/rep/list/instrument/_/_/1/12')
    ->save();
}

/**
 * Update 8002: Ensure the sidebar first width setting is set to 3 columns.
 */
function rep_update_8002() {
  // Retrieve the editable configuration for the Bootstrap Barrio theme.
  $config = \Drupal::configFactory()->getEditable('bootstrap_barrio.settings');

  // Get the current value of the sidebar first width setting.
  $current_value = $config->get('bootstrap_barrio_sidebar_first_width');

  // Check if the current value is not equal to 3.
  if ($current_value != 3) {
    // Update the setting to 3.
    $config->set('bootstrap_barrio_sidebar_first_width', 3)->save();

    // Optionally, add a message to inform the administrator about the change.
    \Drupal::messenger()->addMessage(t('The Sidebar First Width has been updated to 3 cols.'));
  }
}

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * This hook allows REP to:
 * - Register custom access checks for some reviewer menu entries.
 * - Hide Sagres / Social integration menus when disabled in REP config.
 * - Dynamically rename menu titles/descriptions based on the preferred
 *   names configured in rep.settings (instrument, component, workflow, study).
 */
function rep_menu_links_discovered_alter(&$links) {
  // 1) Add custom access callback for some reviewer links.
  $target_links = [
    'reviewer.top_level',
    'reviewer.response_options',
  ];

  foreach ($target_links as $link_key) {
    if (isset($links[$link_key])) {
      // Register the custom access requirement.
      $links[$link_key]['requirements']['_custom_access_check'] = 'TRUE';
    }
  }

  // 2) Hide Sagres / Social integration menus if disabled in REP config.
  $config = \Drupal::config('rep.settings');
  $sagres_enabled = $config->get('sagres_conf');
  $social_enabled = $config->get('social_conf');

  if ($sagres_enabled == 0) {
    $to_hide = [
      'rep.sagres',
      'rep.sagres_config',
      'rep.sagres_status',
    ];

    foreach ($links as $key => $link) {
      if (
        (isset($link['route_name']) && in_array($link['route_name'], [
          'rep.sagres.status_form',
          'rep.sagres.config_form',
        ]))
        || in_array($key, $to_hide, TRUE)
      ) {
        unset($links[$key]);
      }
    }
  }

  if ($social_enabled == 0) {
    $to_hide_social = [
      'rep.socialkg',
      'rep.social_config',
      'rep.social_status',
    ];

    foreach ($links as $key => $link) {
      if (
        (isset($link['route_name']) && in_array($link['route_name'], [
          'social.config_form',
          'social.status_form',
        ]))
        || in_array($key, $to_hide_social, TRUE)
      ) {
        unset($links[$key]);
      }
    }
  }

  // 3) Dynamic menu labels based on preferred names.
  //    This affects menus defined in SIR, STD, DPL that use
  //    Instrument / Component / Workflow / Study terminology.
  $preferred_instrument = $config->get('preferred_instrument') ?: 'Instrument';
  $preferred_component  = $config->get('preferred_component') ?: 'Component';
  $preferred_workflow    = $config->get('preferred_workflow') ?: 'Workflow';
  $preferred_study      = $config->get('preferred_study') ?: 'Study';

  // Normalized labels for UI (first letter uppercase).
  $label_instrument = ucfirst($preferred_instrument);
  $label_component  = ucfirst($preferred_component);
  $label_workflow    = ucfirst($preferred_workflow);
  $label_study      = ucfirst($preferred_study);

  // ------------------------------------------------------------
  // STD: Study-related menus.
  // ------------------------------------------------------------
  $study_map = [
    // std.links.menu.yml
    'std.top_level' => [
      'title' => '@label Elements',
      'description' => 'Manage @label elements',
    ],
    'std.search_option' => [
      'title' => 'Search @label elements',
      'description' => 'Search @label elements',
    ],
    'std.manage_studies' => [
      'title' => 'Manage @label',
      'description' => 'Manage @label items',
    ],
  ];

  // STD: Workflow menus.
  $workflow_map = [
    // std.manage_workflowstems / std.manage_workflow in std.links.menu.yml
    'std.manage_workflowstems' => [
      'title' => 'Manage @label stems',
      'description' => 'Manage @label stems',
    ],
    'std.manage_workflow' => [
      'title' => 'Manage @label',
      'description' => 'Manage @label',
    ],
  ];

  // SIR + DPL: Instrument-related menus.
  $instrument_map = [
    // sir.links.menu.yml
    'sir.top_level' => [
      'title' => '@label Elements',
      'description' => 'Manage @label elements',
    ],
    'sir.search' => [
      'title' => 'Search @label elements',
      'description' => 'Search @label elements',
    ],
    'sir.manage_instruments' => [
      'title' => 'Manage @label',
      'description' => 'Manage @label',
    ],
    // dpl.links.menu.yml
    'dpl.manage_instrument_instances' => [
      'title' => 'Manage @label instances',
      'description' => 'Manage @label instances',
    ],
  ];

  // SIR + DPL: Component-related menus.
  $component_map = [
    // sir.manage_componentstems / sir.manage_components in sir.links.menu.yml
    'sir.manage_componentstems' => [
      'title' => 'Manage @label stems',
      'description' => 'Manage @label stems',
    ],
    'sir.manage_components' => [
      'title' => 'Manage @label',
      'description' => 'Manage @label',
    ],
    // dpl.manage_component_instances in dpl.links.menu.yml
    'dpl.manage_component_instances' => [
      'title' => 'Manage @label instances',
      'description' => 'Manage @label instances',
    ],
  ];

  // ------------------------------------------------------------
  // Apply the maps safely: only touch links that actually exist.
  // This is important because SIR / STD / DPL modules may or may
  // not be enabled on a given repository instance.
  // ------------------------------------------------------------

  // Study.
  foreach ($study_map as $plugin_id => $texts) {
    if (!isset($links[$plugin_id])) {
      continue;
    }
    if (!empty($texts['title'])) {
      $links[$plugin_id]['title'] = new TranslatableMarkup(
        $texts['title'],
        ['@label' => $label_study]
      );
    }
    if (!empty($texts['description'])) {
      $links[$plugin_id]['description'] = new TranslatableMarkup(
        $texts['description'],
        ['@label' => $label_study]
      );
    }
  }

  // Workflow.
  foreach ($workflow_map as $plugin_id => $texts) {
    if (!isset($links[$plugin_id])) {
      continue;
    }
    if (!empty($texts['title'])) {
      $links[$plugin_id]['title'] = new TranslatableMarkup(
        $texts['title'],
        ['@label' => $label_workflow]
      );
    }
    if (!empty($texts['description'])) {
      $links[$plugin_id]['description'] = new TranslatableMarkup(
        $texts['description'],
        ['@label' => $label_workflow]
      );
    }
  }

  // Instrument.
  foreach ($instrument_map as $plugin_id => $texts) {
    if (!isset($links[$plugin_id])) {
      continue;
    }
    if (!empty($texts['title'])) {
      $links[$plugin_id]['title'] = new TranslatableMarkup(
        $texts['title'],
        ['@label' => $label_instrument]
      );
    }
    if (!empty($texts['description'])) {
      $links[$plugin_id]['description'] = new TranslatableMarkup(
        $texts['description'],
        ['@label' => $label_instrument]
      );
    }
  }

  // Component.
  foreach ($component_map as $plugin_id => $texts) {
    if (!isset($links[$plugin_id])) {
      continue;
    }
    if (!empty($texts['title'])) {
      $links[$plugin_id]['title'] = new TranslatableMarkup(
        $texts['title'],
        ['@label' => $label_component]
      );
    }
    if (!empty($texts['description'])) {
      $links[$plugin_id]['description'] = new TranslatableMarkup(
        $texts['description'],
        ['@label' => $label_component]
      );
    }
  }
}

/**
 * Custom access callback function.
 *
 * This can be used whenever you want to restrict a menu link (or route)
 * to users that:
 *   - Have the "content_editor" role, and
 *   - Do NOT have the "administrator" role.
 *
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The current user account.
 *
 * @return \Drupal\Core\Access\AccessResultInterface
 *   Allowed if the user matches the criteria, forbidden otherwise.
 */
function rep_custom_access_callback(AccountInterface $account) {
  // Check if the user has the 'content_editor' role.
  $has_content_editor = $account->hasRole('content_editor');

  // Check if the user does NOT have the 'administrator' role.
  $is_not_administrator = !$account->hasRole('administrator');

  if ($has_content_editor && $is_not_administrator) {
    return AccessResult::allowed()->cachePerUser();
  }

  return AccessResult::forbidden()->cachePerUser();
}

/**
 * Implements hook_file_download().
 *
 * Allows authenticated users to download files from private://resources/.
 * - If the file extension is ".pdf" a PDF content type is sent.
 * - Otherwise the file is treated as a JPEG image.
 *
 * @param string $uri
 *   The file URI being requested.
 *
 * @return array|int
 *   An array of HTTP headers to allow access, or -1 to deny access.
 */
function rep_file_download($uri) {
  // Allow access only to files under private://resources/.
  if (strpos($uri, 'private://resources/') === 0) {
    // Only authenticated users can download these resources.
    if (\Drupal::currentUser()->isAuthenticated()) {
      $extension = pathinfo($uri, PATHINFO_EXTENSION);

      if (strtolower($extension) === 'pdf') {
        return [
          'Content-Type' => 'application/pdf',
        ];
      }
      else {
        // Default to JPEG for non-PDF image files.
        return [
          'Content-Type' => 'image/jpeg',
        ];
      }
    }
    else {
      // Anonymous users are not allowed to download from this directory.
      return -1;
    }
  }

  // For any other path, deny by default.
  return -1;
}

/**
 * Implements hook_page_attachments().
 *
 * Globally attaches the rep_js_css library to every page.
 *
 * @param array $attachments
 *   Page attachments array (libraries, CSS, JS, etc.).
 */
function rep_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'rep/rep_js_css';
}

/**
 * Implements hook_block_view_alter().
 *
 * Dynamically adjusts block titles/labels according to the preferred names
 * stored in rep.settings (instrument, component, workflow, study).
 *
 * It looks at the current block label and replaces occurrences of:
 *   - Study / Studies
 *   - Instrument / Instruments
 *   - Component / Components
 *   - Workflow / Workflows
 * with the administrator-defined preferred terms.
 *
 * Example:
 *   "Search Studies Criteria"  ->  "Search RGPD Criteria"
 *   "Search Instrument Criteria" -> "Search Tool Criteria"
 */
function rep_block_view_alter(array &$build, BlockPluginInterface $block) {
  // Read preferred names from REP configuration.
  $config = \Drupal::config('rep.settings');

  $preferred_instrument = $config->get('preferred_instrument') ?: 'Instrument';
  $preferred_component  = $config->get('preferred_component') ?: 'Component';
  $preferred_workflow    = $config->get('preferred_workflow') ?: 'Workflow';
  $preferred_study      = $config->get('preferred_study') ?: 'Study';

  // Normalized labels for UI (first letter uppercase).
  $label_instrument = ucfirst($preferred_instrument);
  $label_component  = ucfirst($preferred_component);
  $label_workflow    = ucfirst($preferred_workflow);
  $label_study      = ucfirst($preferred_study);

  // Get current label from the build array.
  if (!isset($build['#configuration']['label'])) {
    // Some blocks might not have a label; nothing to change.
    return;
  }

  $current_label = $build['#configuration']['label'];

  // Convert TranslatableMarkup or other objects to plain string.
  if ($current_label instanceof TranslatableMarkup) {
    $label_text = $current_label->render();
  }
  else {
    $label_text = (string) $current_label;
  }

  if ($label_text === '') {
    return;
  }

  // Replacement map: any occurrence of these words will be replaced
  // by the corresponding preferred label (singular form).
  // Note: we deliberately map plural forms (Studies/Instruments/etc.)
  // to the same preferred label string. This can produce:
  //   "Search RGPD Criteria" (from "Search Studies Criteria"),
  // which is acceptable for this use case.
  $replacements = [
    'Study'      => $label_study,
    'Studies'    => $label_study,
    'Instrument' => $label_instrument,
    'Instruments'=> $label_instrument,
    'Component'  => $label_component,
    'Components' => $label_component,
    'Workflow'    => $label_workflow,
    'Workflows'  => $label_workflow,
  ];

  $new_text = strtr($label_text, $replacements);

  // If nothing changed, we can return early.
  if ($new_text === $label_text) {
    return;
  }

  // Wrap the new label as a TranslatableMarkup so it can still be translated.
  $new_label = new TranslatableMarkup($new_text);

  // Update the block configuration label for rendering.
  $build['#configuration']['label'] = $new_label;

  // Also set #title explicitly, to cover themes that read from here.
  $build['#title'] = $new_label;
}


