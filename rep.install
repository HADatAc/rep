<?php

/**
 * Update #9001: Change user_tracking URLs to LONGTEXT and rebuild PK.
 */
function rep_update_9001() {
  $db = \Drupal::database();
  $schema = $db->schema();
  if ($schema->tableExists('user_tracking')) {
    $schema->dropPrimaryKey('user_tracking');
    if ($schema->fieldExists('user_tracking', 'previous_url')) {
      $schema->changeField('user_tracking', 'previous_url', 'previous_url', [
        'type' => 'text', 'size' => 'big', 'not null' => FALSE,
      ]);
    }
    if ($schema->fieldExists('user_tracking', 'current_url')) {
      $schema->changeField('user_tracking', 'current_url', 'current_url', [
        'type' => 'text', 'size' => 'big', 'not null' => FALSE,
      ]);
    }
    // Raw SQL for the PK with prefix length.
    $db->query("
      ALTER TABLE {user_tracking}
      ADD PRIMARY KEY (uid, current_url(191))
    ");
  }
}

function rep_schema() {
  $schema['rep_entry_point_mapping'] = [
    'description' => 'Mapping EntryPoints for Ontology',
    'fields' => [
      'id' => [
        'description' => 'Primary Key',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ],
      'entry_point_uri' => [
        'description' => 'URI of entry point (e.g. http://…/instrument).',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
      ],
      'node_uri' => [
        'description' => 'Complete URI',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
      ],
    ],
    'primary key' => ['id'],
  ];

  $schema['rep_org_edit_suggestions'] = [
    'description' => 'Pending suggested edits for Organizations (review workflow).',
    'fields' => [
      'id' => [
        'description' => 'Primary Key',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'organization_uri' => [
        'description' => 'Organization URI being suggested for edit.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'suggested_by_uid' => [
        'description' => 'Drupal user id who submitted the suggestion.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'suggested_by_email' => [
        'description' => 'Email of submitter (snapshot).',
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'created' => [
        'description' => 'Unix timestamp when suggestion was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'payload' => [
        'description' => 'JSON payload with suggested organization fields.',
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'organization_uri' => ['organization_uri'],
      'created' => ['created'],
    ],
  ];

  $schema['rep_wkf_phase_state'] = [
    'description' => 'Current public WKF phase by WKF scope.',
    'fields' => [
      'scope' => [
        'description' => 'Deterministic WKF scope key (wkf_<sha1-prefix>).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'wkf_uri' => [
        'description' => 'Normalized WKF URI.',
        'type' => 'varchar',
        'length' => 512,
        'not null' => FALSE,
      ],
      'public_phase' => [
        'description' => 'Current public phase (2..4).',
        'type' => 'int',
        'unsigned' => TRUE,
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 2,
      ],
      'updated' => [
        'description' => 'Unix timestamp of last phase update.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['scope'],
    'indexes' => [
      'wkf_uri' => ['wkf_uri'],
      'public_phase' => ['public_phase'],
      'updated' => ['updated'],
    ],
  ];
  return $schema;
}

/**
 * Update #9003: Create rep_entry_point_mapping is missing.
 */
function rep_update_9003() {
  $schema_def = rep_schema()['rep_entry_point_mapping'];
  $db = \Drupal::database();
  $sm = $db->schema();
  if (! $sm->tableExists('rep_entry_point_mapping')) {
    $sm->createTable('rep_entry_point_mapping', $schema_def);
  }
}

/**
 * Update #9004: Grant ontology administration permission to intended roles.
 */
function rep_update_9004() {
  $roles = ['administrator', 'content_editor'];
  foreach ($roles as $role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    if ($role && ! $role->hasPermission('administer semantic ontologies')) {
      $role->grantPermission('administer semantic ontologies')->save();
    }
  }
}

/**
 * Update #9010: Create rep_org_edit_suggestions table if missing.
 */
function rep_update_9010() {
  $schema_def = rep_schema()['rep_org_edit_suggestions'];
  $db = \Drupal::database();
  $sm = $db->schema();
  if (! $sm->tableExists('rep_org_edit_suggestions')) {
    $sm->createTable('rep_org_edit_suggestions', $schema_def);
  }
}

/**
 * Update #9011: Create rep_wkf_phase_state table if missing.
 */
function rep_update_9011() {
  $schema_def = rep_schema()['rep_wkf_phase_state'];
  $db = \Drupal::database();
  $sm = $db->schema();
  if (!$sm->tableExists('rep_wkf_phase_state')) {
    $sm->createTable('rep_wkf_phase_state', $schema_def);
  }
}

/**
 * Update #9012: Backfill rep_wkf_phase_state from key-value phase store.
 */
function rep_update_9012() {
  $db = \Drupal::database();
  $sm = $db->schema();
  if (!$sm->tableExists('rep_wkf_phase_state')) {
    return;
  }

  $kv = \Drupal::keyValue('rep.wkf.public_phase.by_scope');
  if (!method_exists($kv, 'getAll')) {
    return;
  }

  $all = $kv->getAll();
  if (!is_array($all) || empty($all)) {
    return;
  }

  foreach ($all as $scope => $entry) {
    if (!is_string($scope) || trim($scope) === '' || !is_array($entry)) {
      continue;
    }

    $phase = isset($entry['phase']) ? (int) $entry['phase'] : 0;
    if ($phase < 2 || $phase > 4) {
      continue;
    }

    $wkfUri = isset($entry['wkfUri']) && is_string($entry['wkfUri'])
      ? trim($entry['wkfUri'])
      : '';

    $db->merge('rep_wkf_phase_state')
      ->key(['scope' => trim($scope)])
      ->fields([
        'wkf_uri' => $wkfUri,
        'public_phase' => $phase,
        'updated' => time(),
      ])
      ->execute();
  }
}
